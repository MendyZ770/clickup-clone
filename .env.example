DATABASE_URL="postgresql://user:password@host:5432/clickup_clone?sslmode=require"
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Android Release Signing (définies dans ~/.gradle/gradle.properties ou env CI)
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=

# Upstash Redis (rate limiting) — optionnel, désactivé si absent
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Auth et sessions
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Tâches planifiées Vercel (en-tête Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Téléversement de fichiers (Vercel Blob) ; sans jeton, écriture disque impossible en production
BLOB_READ_WRITE_TOKEN=

# Base de données
PG_POOL_MAX=3
SEED_ALLOW_REMOTE=

# Resend (e-mails)
RESEND_API_KEY=
FROM_EMAIL="Done <noreply@example.com>"

# Pusher (temps réel)
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# Notifications web push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL="mailto:ops@example.com"

# Firebase Cloud Messaging (optionnel)
FIREBASE_SERVICE_ACCOUNT=

# Google Calendar (optionnel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Enable Banking (budget, optionnel)
EB_APP_ID=
EB_PRIVATE_KEY=

# Build
ANALYZE=

# Canaux Pusher privés (endpoint /api/pusher/auth). Mettre "false" uniquement
# pour revenir aux anciens canaux publics si l'endpoint n'est pas déployé.
NEXT_PUBLIC_PUSHER_PRIVATE="true"

# Clé de chiffrement AES-256-GCM (32 octets en base64) des tokens OAuth au repos.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OAUTH_ENCRYPTION_KEY=""
